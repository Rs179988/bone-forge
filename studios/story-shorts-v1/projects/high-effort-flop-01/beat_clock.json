  "beats": [
    {
      "beat_id": "beat_01_hook_pattern_interrupt",
      "spoken_line": "Tumne apni pichli video ke 3-second ke transition par 4 ghante lagaye... aur viewer ne use 0.5 second mein swipe kar diya. Bura laga? Good. Ab sach suno.",
      "start_frame": 0,
      "end_frame": 590,
      "duration_frames": 590,
      "start_sec": 0.0,
      "end_sec": 9.833
    },
    {
      "beat_id": "beat_02_reality_check_agitation",
      "spoken_line": "90 percent naye creators ko lagta hai ki unhe ek viral editing pack ya naye AI plugin ki zaroorat hai. Nahi. Tumhara color grade cinematic hai, sound design crispy hai\u2014par tumhari video boring hai. Kyunki tum apne liye edit kar rahe ho, dusre editors ko flex dikhane ke liye. Audience ko tumhare keyframes se ghanta farak nahi padta.",
      "start_frame": 590,
      "end_frame": 1535,
      "duration_frames": 945,
      "start_sec": 9.833,
      "end_sec": 25.583
    },
    {
      "beat_id": "beat_03_the_fix_three_questions",
      "spoken_line": "Agli video render karne se pehle apne timeline ko mute karo, saare effects band karo, aur khud se yeh teen sawaal poocho. Pehla, 3-Second Hook: Kya mera pehla sentence kisi ke dimaag mein khujli paida kar raha hai? Agar tum Hey guys welcome back bol rahe ho, toh wahin khel khatam hai. Doosra, 15-Second Rule: Kya har 15 second mein story ki direction badal rahi hai? Teesra, The Cut Test: Agar main is clip ko hata doon, toh kya story tootegi? Agar nahi, toh delete maaro.",
      "start_frame": 1535,
      "end_frame": 2858,
      "duration_frames": 1323,
      "start_sec": 25.583,
      "end_sec": 47.633
    },
    {
      "beat_id": "beat_04_mic_drop_outro",
      "spoken_line": "Editing ka kaam story ko chhupana nahi, story ko raste se bhatakne se rokna hai. Agli video mein 50 percent kam effects lagao, aur 200 percent zyada dimaag apne hook aur script par lagao. Ab yeh Reel save karke mat chhod dena\u2014apna timeline kholo aur sabse pehle woh fancy intro udao.",
      "start_frame": 2858,
      "end_frame": 3685,
      "duration_frames": 827,
      "start_sec": 47.633,
      "end_sec": 61.417
    }
  ],
